# ===============================
# 🤖 Discord Bot Settings
# ===============================

# Discord Bot Token
TOKEN="PUT_YOUR_BOT_TOKEN_HERE"

# Bot Prefix (لو لسه عندك أوامر prefix)
PREFIX="!"

# Main Discord Server ID
SERVER_ID="1292788778422763520"


# ===============================
# 🌐 Web Dashboard Settings
# ===============================

# Web Server Port (اختياري – الافتراضي 3000)
PORT=3000

# Session Secret (غيره بقيمة عشوائية طويلة)
SESSION_SECRET="AVON_SUPER_SECRET_SESSION_2026"


# ===============================
# 🔐 Discord OAuth Settings
# ===============================

# Discord Application Client ID
DISCORD_CLIENT_ID="PUT_CLIENT_ID_HERE"

# Discord Application Client Secret
DISCORD_CLIENT_SECRET="PUT_CLIENT_SECRET_HERE"

# OAuth Callback URL
# لازم تكون مضافة في Discord Developer Portal
DISCORD_CALLBACK_URL="http://localhost:3000/auth/discord/callback"


# ===============================
# 💾 Database Settings
# ===============================

# Database Type: json | mysql | mongodb
DATABASE_TYPE="json"

# في حالة MongoDB
MONGO_URI=""

# في حالة MySQL
MYSQL_HOST=""
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE=""


# ===============================
# 👑 Owners & Permissions
# ===============================

# Bot Owners (IDs مفصولة بفاصلة)
OWNERS="123456789012345678,987654321098765432"


# ===============================
# 📡 Webhook Logs (اختياري)
# ===============================

# Webhook URL لتسجيل Errors أو Economy Logs
WEBHOOK_URL=""


# ===============================
# ⚠️ Development / Debug
# ===============================

# Development Mode
DEV_MODE=false